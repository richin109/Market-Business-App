# Copy to .env for local development. Never commit .env or real credentials.
POSTGRES_DB=mbs
POSTGRES_USER=mbs
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://mbs:change-me@postgres:5432/mbs
REDIS_URL=redis://redis:6379/0

# MVP 1 (not used by the foundation slice)
RECEIPT_FILE_STORE_PATH=/data/receipts
SESSION_SECRET=replace-with-random-value
GOOGLE_APPLICATION_CREDENTIALS=
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=
DOCUMENT_AI_PROCESSOR_ID=

# Future capabilities (placeholders only)
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
