# Copy to .env for local development. Never commit .env or real credentials.
POSTGRES_DB=mbs
POSTGRES_USER=mbs
POSTGRES_PASSWORD=change-me
# Optional full SQLAlchemy URL override. Compose otherwise builds it from POSTGRES_*.
# URL overrides need percent-encoded credentials; split fields accept literal passwords.
DATABASE_URL=
# Local loopback-only ports for VS Code host debugging and isolated PostgreSQL tests.
MBS_POSTGRES_PORT=5432
MBS_TEST_POSTGRES_PORT=55432
REDIS_URL=redis://redis:6379/0

# Shared protected-file path used by the web and worker containers.
RECEIPT_STORAGE_PATH=/var/lib/mbs/receipts
GOOGLE_APPLICATION_CREDENTIALS=
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=
DOCUMENT_AI_PROCESSOR_ID=

# Future capabilities (placeholders only)
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
